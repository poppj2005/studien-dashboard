#!/bin/bash
# Startet das Studien-Dashboard mit dem python.org-Python (funktionierendes Tk).
# $0 liegt unter <Projekt>/Studien-Dashboard.app/Contents/MacOS/, drei Ebenen
# darüber liegt der Projektordner mit main.py.

PROJEKT_VERZEICHNIS="$(cd "$(dirname "$0")/../../.." && pwd)"
PYTHON_BIN="/Library/Frameworks/Python.framework/Versions/3.14/bin/python3"

cd "$PROJEKT_VERZEICHNIS" || exit 1

if [ ! -x "$PYTHON_BIN" ]; then
    osascript -e 'display alert "Python nicht gefunden" message "Erwartetes Python unter /Library/Frameworks/Python.framework/Versions/3.14/bin/python3 wurde nicht gefunden."'
    exit 1
fi

"$PYTHON_BIN" "$PROJEKT_VERZEICHNIS/main.py" 2> "$PROJEKT_VERZEICHNIS/dashboard_fehler.log"
STATUS=$?

if [ $STATUS -ne 0 ]; then
    osascript -e "display alert \"Studien-Dashboard konnte nicht gestartet werden\" message \"Details siehe dashboard_fehler.log im Projektordner.\""
fi

exit $STATUS
